      "2025-01-01",
      "2025-02-01",
      "2025-03-01",
      "2025-04-01",
      "2025-05-01",
      "2025-06-01",
      "2025-07-01",
      "2025-08-01",
      "2025-09-01",
      "2025-10-01",
      "2025-11-01",
      "2025-12-01"
    ],
    "train_rule": "Для прогноза месяца M доступны только факты с датой < M; очистка, параметры и выбор модели не используют более поздние наблюдения или validation/truth.json.",
    "target": "Скрытый регулярный спрос календарного месяца в учётных единицах; возвраты и разовая клиентская сделка не являются регулярным спросом.",
    "minimum_history_months_for_primary_forecast_metrics": 12,
    "primary_forecast_scenarios": [
      "stable",
      "seasonal",
      "growth"
    ],
    "baselines": [
      "last_complete_month",
      "mean_of_last_3_complete_months",
      "same_month_previous_year"
    ],
    "baseline_rule": "Базовые прогнозы строятся только по наблюдаемым данным на тот же origin; лучший baseline выбирается для итогового сравнения, а не для подглядывающего выбора модели по тестовому месяцу.",
    "metrics": {
      "wape": "sum(abs(predicted_regular_demand - true_regular_demand)) / sum(true_regular_demand), отдельно для каждого SKU",
      "absolute_error": "abs(actual - expected)",
      "relative_error": "abs(actual - expected) / abs(expected), только если expected != 0",
      "zero_denominator": "Если сумма истинного спроса равна 0, WAPE не вычисляется; используется MAE и точная проверка нулевого заказа.",
      "peak_to_mean": "max(monthly_quantity) / mean(monthly_quantity) за 12 месяцев",
      "growth_ratio": "mean(Oct,Nov,Dec) / mean(Jan,Feb,Mar) одного проверочного года",
      "comparison_currency": "Доли, не проценты: 0.10 = 10%; разность WAPE 0.02 = 2 процентных пункта."
    },
    "time_convention": {
      "as_of": "Начало дня 0; текущий физический остаток относится к этой дате.",
      "horizon_days": "lead_time_days + review_period_days",
      "demand_days": "Дни 1..H включительно; потребление в конце дня.",
      "incoming": "Поступление в начале указанного дня; ETA <= H включается в ресурс горизонта, ETA > H не включается. Календарь дефицита проверяется отдельно от общей суммы.",
      "safety_stock": "В ручных примерах constant_daily_demand * safety_days.",
      "new_order": "Ручная потребность — требуемое количество нового заказа. Календарь существующего запаса и пути проверяется до включения нового заказа."
    },
    "tolerances_policy": "Численные пороги меняются только новой версией спецификации с причиной; прохождение набора нельзя достигать изменением truth/критериев после просмотра результата модели.",
    "manual_cases_are_synthetic": true,
    "all_future_checks_pending": true
  },
