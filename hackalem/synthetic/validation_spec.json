      "validation/truth.json",
      "validation/scenarios.json",
      "validation/spec.json"
    ],
    "parameters_status": "scenario",
    "numerical_accuracy_proves_real_world_accuracy": false
  },
  "evaluation_protocol": {
    "forecast_frequency": "month",
